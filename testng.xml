<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="NRI Cross Browser Suite"
       parallel="tests"
       thread-count="2">

	<listeners>
        <listener class-name="testComponant.Listeners"/>
        <listener class-name="testComponant.RetryListener"/>
    </listeners>

    <test name="Chrome Execution">        
        <parameter name="browserName" value="chrome"/>
        <classes>
            <class name="testClasses.CreateNRISavingAccount"/>
        </classes>
    </test>

    <test name="Edge Execution">
        <parameter name="browserName" value="edge"/>
        <classes>
            <class name="testClasses.CreateNRISavingAccount"/>
        </classes>
    </test>

</suite>